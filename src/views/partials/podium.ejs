<% if (payload && payload.rows && payload.rows.length >= 1) { %>
<div class="podium">
  <% const top3 = payload.rows.slice(0, 3); %>
  <% const order = top3.length >= 3 ? [1, 0, 2] : top3.length === 2 ? [0, 1] : [0]; %>
  <% order.forEach(function(i) { %>
  <% const r = top3[i]; if (!r) return; %>
  <div class="podium-place podium-place--<%= i + 1 %>">
    <div class="podium-medal"><%= i === 0 ? "&#127947;" : i === 1 ? "&#129352;" : "&#129353;" %></div>
    <div class="podium-rank">#<%= r.rank %></div>
    <div class="podium-manager"><%= r.manager %></div>
    <div class="podium-team"><%= r.team_name %></div>
    <div class="podium-pts"><%= r.total_points %> pts</div>
  </div>
  <% }); %>
</div>
<% } %>
